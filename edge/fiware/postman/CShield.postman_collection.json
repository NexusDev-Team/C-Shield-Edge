        {
          "name": "Subscribe temperature (STH)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "fiware-service",
                "value": "smart"
              },
              {
                "key": "fiware-servicepath",
                "value": "/"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{url}}:1026/v2/subscriptions",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "1026",
              "path": [
                "v2",
                "subscriptions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"C-Shield STH temperature\",\n  \"subject\": {\n    \"entities\": [\n      {\n        \"id\": \"{{entity_id}}\",\n        \"type\": \"CShield\"\n      }\n    ],\n    \"condition\": {\n      \"attrs\": [\n        \"temperature\"\n      ]\n    }\n  },\n  \"notification\": {\n    \"http\": {\n      \"url\": \"{{sth_internal}}/notify\"\n    },\n    \"attrs\": [\n      \"temperature\"\n    ],\n    \"attrsFormat\": \"legacy\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A URL de notificacao usa o nome interno do container (sth-comet), nao o IP publico."
          }
